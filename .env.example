# Google OAuth 2.0 Credentials (Opsional - Tradelog menyediakan fitur Google Login instan otomatis)
# Untuk menggunakan OAuth Google resmi langsung dari Google Cloud Console:
# 1. Buka https://console.cloud.google.com/apis/credentials
# 2. Buat "OAuth client ID" tipe "Web application"
# 3. Masukkan Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
